{{- $pages := (where site.RegularPages "Section" "in" (slice "tech" "work" "life")).ByDate.Reverse -}}
[
{{- range $i, $p := $pages }}
{{- $section := $p.CurrentSection.Title }}
{{- $desc := $p.Description | default ($p.Summary | plainify) }}
{{- if $i }},{{ end }}
{
  "title": {{ $p.Title | jsonify }},
  "url": {{ $p.RelPermalink | jsonify }},
  "date": {{ $p.Date.Format "2006-01-02" | jsonify }},
  "section": {{ $section | jsonify }},
  "tags": {{ if $p.Params.tags }}{{ $p.Params.tags | jsonify }}{{ else }}[]{{ end }},
  "summary": {{ $desc | jsonify }},
  "content": {{ $p.Plain | jsonify }}
}
{{- end }}
]
